rules_version = '2';

// Schema (see src/lib/store.ts FirestoreStore for the reads/writes that drive this):
//   households/{householdId}/uidMap/{uid}                      -> { memberId }
//   households/{householdId}/exclusions/{id}                    -> Exclusion
//   households/{householdId}/mealPlan/{date}                     -> DayPlan
//   households/{householdId}/members/{memberId}                  -> PublicMemberInfo {id, displayName}
//   households/{householdId}/members/{memberId}/private/profile  -> MemberProfile (biometrics, goals, macros)
//   households/{householdId}/members/{memberId}/private/metrics  -> PrivateMetrics (body fat %, exact weight)
//   households/{householdId}/digests/{weekId-memberId}           -> DigestEntry
//
// Privacy model (PRD 6.3/11):
//  - members/{memberId} is the ONLY thing readable without authentication -- just a
//    chosen nickname, needed to render the login picker. Never biometrics/goals/macros.
//  - private/profile (age, height, weight, goal, macro targets) is readable by any
//    authenticated household member (meal planning needs everyone's targets), but only
//    editable by that person or the admin (Alex).
//  - private/metrics (body fat %, exact weight, weight trend) is visible only to the
//    subject + Alex.
//  - Damian's digest is admin-only -- never readable by Damian himself.

service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{householdId} {

      function isHouseholdMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/households/$(householdId)/uidMap/$(request.auth.uid));
      }

      function myMemberId() {
        return get(/databases/$(database)/documents/households/$(householdId)/uidMap/$(request.auth.uid)).data.memberId;
      }

      function isAdmin() {
        return isHouseholdMember() && myMemberId() == 'alex';
      }

      // A signed-in user may only claim their own uid, and only once.
      match /uidMap/{uid} {
        allow read: if isHouseholdMember();
        allow create: if request.auth != null && request.auth.uid == uid && !exists(/databases/$(database)/documents/households/$(householdId)/uidMap/$(uid));
        allow update, delete: if false;
      }

      match /exclusions/{exclusionId} {
        allow read, write: if isHouseholdMember();
      }

      match /mealPlan/{date} {
        allow read, write: if isHouseholdMember();
      }

      // Public: id + chosen nickname only, needed pre-auth for the login picker.
      match /members/{memberId} {
        allow read: if true;
        allow write: if isHouseholdMember() && (myMemberId() == memberId || isAdmin());
      }

      match /members/{memberId}/private/profile {
        allow read: if isHouseholdMember();
        allow write: if isHouseholdMember() && (myMemberId() == memberId || isAdmin());
      }

      match /members/{memberId}/private/metrics {
        allow read, write: if isHouseholdMember() && (myMemberId() == memberId || isAdmin());
      }

      match /digests/{digestId} {
        allow read, write: if isAdmin();
      }
    }
  }
}
