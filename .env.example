# Copy this file to .env.local (git-ignored) for local dev, and add the same
# values as repository secrets for the GitHub Actions deploy workflow.
# Get these from Firebase console -> Project settings -> General -> Your apps -> SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Any short identifier for this household's Firestore document namespace.
VITE_HOUSEHOLD_ID=default-household
